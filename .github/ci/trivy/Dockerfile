# Not built. This file exists so the Trivy scanner that verify-image.sh runs has its version in
# a place Dependabot's docker ecosystem watches (see .github/dependabot.yml). A pin inside a shell
# script is one nothing ever bumps. verify-image.sh reads the FROM reference below and runs it.
#
# Tag AND digest, like the base image. The index digest was checked identical on Docker Hub and
# GHCR (ghcr.io/aquasecurity/trivy) on 2026-10-27.
FROM aquasec/trivy:0.76.1@sha256:790fd66d1697395d8693d1acaa1ea702406a20f109b6fc7bac8db623eca6c06c
