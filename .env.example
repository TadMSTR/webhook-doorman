# webhook-doorman secrets. Copy to .env, fill in, and keep it out of version control.
#
# config.yml references these BY NAME (secret_env: GITHUB_WEBHOOK_SECRET). No value in this
# file ever appears in the YAML.
#
# In Docker, pass this file with compose's `env_file:` rather than bind-mounting it. The Docker
# daemon reads env_file as root at container start, so the file can stay 0600 and owned by you
# while the container itself runs as a non-root user. A bind-mounted 0600 file is unreadable to
# that user and the service fails closed at boot with a confusing error.

# --- Source verification ---------------------------------------------------------------------
GITHUB_WEBHOOK_SECRET=
TRACKER_WEBHOOK_SECRET=
GRAFANA_WEBHOOK_TOKEN=

# --- Sinks -----------------------------------------------------------------------------------
MATRIX_HOMESERVER=
MATRIX_TOKEN=
MATRIX_ROOM=

NTFY_TOPIC=
NTFY_TOKEN=

ALERT_WEBHOOK_URL=

# --- Admin -----------------------------------------------------------------------------------
# POST /admin/replay/{event_id}. At least 32 characters, or replay stays disabled.
#   openssl rand -hex 32
ADMIN_TOKEN=

# --- Runtime ---------------------------------------------------------------------------------
LOG_LEVEL=INFO
